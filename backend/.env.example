# backend/.env.example  ->  nusxa oling: backend/.env  (HECH QACHON gitga yuklamang)

# ---- Baza ----
# Lokal (docker compose up -d) uchun ikkalasi bir xil. Supabase uchun README dagi "Deploy" bo'limiga qarang.
DATABASE_URL="postgresql://grantora:grantora_dev@localhost:5432/grantora?schema=public"
DIRECT_URL="postgresql://grantora:grantora_dev@localhost:5432/grantora?schema=public"

# ---- Maxfiy kalitlar (uzun tasodifiy qator; har biri har xil) ----
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
OTP_PEPPER=""

# ---- Server ----
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
COOKIE_SECURE=false           # productionda (https) true

# ---- Birinchi admin (npm run db:seed yaratadi) ----
ADMIN_EMAIL="admin@grantora.local"
ADMIN_PASSWORD=""             # kamida 8 belgi, katta/kichik harf, raqam, belgi

# ---- Pochta ----
MAIL_PROVIDER=smtp            # smtp | brevo   (Render bepul rejasida faqat brevo)
MAIL_FROM="Grantora <no-reply@grantora.local>"
SMTP_HOST=localhost           # lokal: Mailpit (http://localhost:8025 da xatlarni ko'rasiz)
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=

# ---- Hujjatlar ombori (bo'sh qolsa: lokal ./uploads papkasi) ----
SUPABASE_URL=                 # https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=         # Project Settings -> API -> service_role (MAXFIY! faqat serverda)
SUPABASE_BUCKET=documents     # PRIVATE bucket
