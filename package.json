{
  "name": "grantora",
  "private": true,
  "workspaces": [
    "backend", "frontend"
  ],
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "api": "npm run start:dev -w backend",
    "web": "npm run dev -w frontend",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:seed": "npm run prisma:seed -w backend",
    "backend": "npm run start:dev -w backend",
    "frontend": "npm run dev -w frontend",
    "db:push": "npm run prisma:push -w backend",
    "db:studio": "npm run prisma:studio -w backend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend"
  }
}
