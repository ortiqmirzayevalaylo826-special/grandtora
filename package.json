{
  "name": "grantora",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "api": "npm run start:dev -w apps/api",
    "web": "npm run dev -w apps/web",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "backend": "npm run start:dev -w apps/api",
    "frontend": "npm run dev -w apps/web",
    "db:push": "npm run prisma:push -w apps/api",
    "db:studio": "npm run prisma:studio -w apps/api",
    "build:backend": "npm run build -w apps/api",
    "build:frontend": "npm run build -w apps/web"
  }
}
